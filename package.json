{
  "name": "batoot-crochet",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite --host 0.0.0.0 --port 5173",
    "build": "vite build && wrangler pages functions build --outdir ./dist/worker --compatibility-date=2025-09-01",
    "preview": "vite preview --host 0.0.0.0 --port 5173",
    "db:seed": "wrangler d1 execute batoot --local --persist-to=.wrangler/state --file=./schema.sql",
    "db:seed:remote": "wrangler d1 execute batoot --remote --file=./schema.sql",
    "dev:cf": "npm run build && wrangler dev --persist-to=.wrangler/state --ip 0.0.0.0 --port 8788"
  },
  "dependencies": {
    "clsx": "^2.1.1",
    "lucide-react": "^0.475.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "tailwind-merge": "^3.0.1"
  },
  "devDependencies": {
    "@types/react": "^18.3.18",
    "@types/react-dom": "^18.3.5",
    "@vitejs/plugin-react": "^4.3.4",
    "autoprefixer": "^10.4.20",
    "jsdom": "^30.0.1",
    "postcss": "^8.5.2",
    "tailwindcss": "^3.4.17",
    "vite": "^6.1.0",
    "wrangler": "^4.129.0"
  }
}
